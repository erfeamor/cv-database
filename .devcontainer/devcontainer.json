{
  "name": "cv-database",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/mysql-client:1": {}
  },
  "postCreateCommand": "docker compose up -d",
  "customizations": {
    "vscode": {
      "extensions": ["cweijan.vscode-mysql-client2"]
    }
  },
  "remoteUser": "vscode"
}
